apiVersion: sparkoperator.k8s.io/v1beta2
kind: SparkApplication
metadata:
  name: pyspark-pi
  namespace: dev-namespace  # <-- Replace with your OpenShift project/namespace
spec:
  type: Python
  mode: cluster
  image: image-registry.openshift-image-registry.svc:5000/dev-namespace/spark-py:latest  # <-- Use internal or accessible registry
  imagePullPolicy: Always
  mainApplicationFile: "local:///opt/spark/scripts/pi.py"
  sparkVersion: "3.1.1"
  restartPolicy:
    type: Never
  driver:
    cores: 1
    memory: "1g"
    serviceAccount: spark-sa  # <-- Must be created and have appropriate SCC (like anyuid)
    labels:
      version: 3.1.1
    env:
      - name: PYSPARK_PYTHON
        value: python3
    volumeMounts:
      - name: spark-scripts
        mountPath: /opt/spark/scripts
  executor:
    cores: 1
    instances: 2
    memory: "1g"
    labels:
      version: 3.1.1
    env:
      - name: PYSPARK_PYTHON
        value: python3
    volumeMounts:
      - name: spark-scripts
        mountPath: /opt/spark/scripts
  volumes:
    - name: spark-scripts
      configMap:
        name: pyspark-pi-script  # <-- Holds pi.py file
